{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.careerground.example/portable-interview-session/1.0",
  "title": "CareerGround text/native voice interview checkpoint 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "kind",
    "session_id",
    "revision",
    "created_at",
    "mode",
    "status",
    "materials",
    "constraints",
    "material_digest",
    "turns",
    "next_step"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "kind": {
      "const": "career-interview-session"
    },
    "session_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
    },
    "revision": {
      "type": "integer",
      "minimum": 1,
      "maximum": 10000
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "mode": {
      "enum": [
        "coaching",
        "simulation"
      ]
    },
    "status": {
      "enum": [
        "ready",
        "in_progress",
        "paused",
        "completed"
      ]
    },
    "materials": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "kind",
          "label",
          "text"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "jd",
              "resume",
              "career",
              "user_statement"
            ]
          },
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 500
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50000
          }
        }
      },
      "maxItems": 50
    },
    "constraints": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 4000
      },
      "maxItems": 100
    },
    "material_digest": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "turns": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "question",
          "material_ids",
          "gap",
          "answers",
          "feedback",
          "candidates"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
          },
          "question": {
            "type": "string",
            "minLength": 1,
            "maxLength": 4000
          },
          "material_ids": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
            },
            "maxItems": 100,
            "uniqueItems": true
          },
          "gap": {
            "type": "boolean"
          },
          "answers": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "revision",
                "text",
                "input_mode",
                "confirmed"
              ],
              "properties": {
                "revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "input_mode": {
                  "enum": [
                    "text",
                    "voice"
                  ]
                },
                "confirmed": {
                  "type": "boolean"
                }
              }
            },
            "maxItems": 100
          },
          "feedback": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "answer_revision",
                "text"
              ],
              "properties": {
                "answer_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                }
              }
            },
            "maxItems": 100
          },
          "candidates": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "id",
                "answer_revision",
                "text",
                "status"
              ],
              "properties": {
                "id": {
                  "type": "string",
                  "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$"
                },
                "answer_revision": {
                  "type": "integer",
                  "minimum": 1,
                  "maximum": 10000
                },
                "text": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 20000
                },
                "status": {
                  "const": "pending"
                }
              }
            },
            "maxItems": 100
          }
        }
      },
      "maxItems": 100
    },
    "next_step": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    }
  }
}
